{
  "name": "supa-preflight",
  "version": "0.1.2",
  "description": "Offline Supabase security preflight for configuration and SQL migrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanskarArnale-07/SupaPreflight.git"
  },
  "homepage": "https://github.com/SanskarArnale-07/SupaPreflight#readme",
  "bugs": {
    "url": "https://github.com/SanskarArnale-07/SupaPreflight/issues"
  },
  "keywords": [
    "supabase",
    "security",
    "cli",
    "preflight",
    "rls",
    "postgres",
    "postgresql",
    "audit",
    "linter"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "supa-preflight": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx src/cli/index.ts check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pgsql-parser": "^18.2.10",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
